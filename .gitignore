# Presentation and pitch decks (keep local, exclude from public repo)
*.pptx
*.ppt

# Environment variables and secrets
.env
.env.*
!.env.example
*.env

# API Keys & Credentials
*.pem
*.key
*.pfx
*.cert
credentials.json
client_secret*.json

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python bytecode, builds, and test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
dist/
build/
*.egg-info/

# Local database and vector storage
chroma_db/
*.db
*.sqlite3

# Local logs and runtime state
*.log
data/*.log
data/lexassist.log

# Private session history & chat records (preserve directory structure with .gitkeep)
data/chats/*.json
!data/chats/.gitkeep

# Large or uploaded raw documents (keep sample documents and gitkeep)
data/raw/*.pdf
data/raw/uploads/
temp/
tmp/

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Streamlit config / secrets
.streamlit/secrets.toml
